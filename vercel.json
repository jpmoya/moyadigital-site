{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/trainers",
      "destination": "/trainers.html"
    }
  ],
  "redirects": [
    {
      "source": "/trainer",
      "destination": "/trainers",
      "permanent": true
    },
    {
      "source": "/site/:path*",
      "destination": "https://xaki.app/site/:path*",
      "permanent": true
    }
  ]
}
